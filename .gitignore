# =============================================================================
# Vignify Monorepo — .gitignore
# =============================================================================

# Dependencies
node_modules/
.pnp
.pnp.*

# Next.js build outputs
.next/
out/

# Vite / general build outputs
dist/
build/

# Mobile — Capacitor web bundle (generated by `npm run build:mobile`)
capacitor-web/

# Android build artifacts (applies to apps/mobile/android/)
local.properties
.gradle/
android/.idea/
android/local.properties
android/.gradle/
android/build/
android/app/build/

# Turbo cache
.turbo/

# Supabase local CLI state (not project code)
supabase/.branches/
supabase/.temp/
supabase/snippets/

# Environment files — NEVER commit secrets
.env
.env.local
.env.*.local

# Testing
coverage/

# Misc system files
.DS_Store
*.pem
Thumbs.db

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel deployment
.vercel

# TypeScript incremental build info (auto-generated)
*.tsbuildinfo
next-env.d.ts

# Database backups — NEVER commit production data
vignify-backup.sql
vignify-production*.sql
storage-schema.sql

# Backup and temporary files
*.bak
*.backup

# Zip archives
*.zip
